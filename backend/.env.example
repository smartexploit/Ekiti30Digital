DATABASE_URL=sqlite:///./dev.db

# Comma-separated list of allowed CORS origins (no spaces needed around commas).
# Example with multiple origins: FRONTEND_ORIGIN=http://localhost:3000,https://staging.example.com
FRONTEND_ORIGIN=http://localhost:3000

# --- Ask Ekiti: LLM / embeddings provider config (not required yet) -------
# No provider has been chosen yet. These are all optional and the app runs
# fine with none of them set. Uncomment and fill in once a provider is
# picked — only that provider's API key needs to be set, nothing else
# changes.
# LLM_PROVIDER=openai
# LLM_MODEL=
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=1536
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
