DATABASE_URL=sqlite:///./dev.db

# Comma-separated list of allowed CORS origins (no spaces needed around commas).
# Example with multiple origins: FRONTEND_ORIGIN=http://localhost:3000,https://staging.example.com
FRONTEND_ORIGIN=http://localhost:3000

# --- Ask Ekiti: LLM / embeddings gateway config (not required yet) --------
# All optional; the app runs fine with none of them set.
# Single gateway endpoint that houses all providers internally — no per-provider keys needed here.
# ASK_EKITI_LLM_WEBHOOK_URL=
# ASK_EKITI_LLM_WEBHOOK_KEY=
# LLM_MODEL=
# Embeddings run locally via sentence-transformers; these are the defaults.
# EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_DIMENSIONS=384
